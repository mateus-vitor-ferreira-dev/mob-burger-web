# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Valores públicos (NEXT_PUBLIC_*), que vão para o JavaScript do navegador de qualquer jeito
!.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Avatar uploads locais
public/uploads/

# cloudflare (opennext + wrangler)
.open-next
.wrangler
.dev.vars*
!.dev.vars.example
cloudflare-env.d.ts
